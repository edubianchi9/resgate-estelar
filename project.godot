; Engine configuration file.
; Resgate Estelar — Aula 08: arena e movimento em quatro direções.

config_version=5

[application]

config/name="Resgate Estelar"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[input]

left={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":4194319), Object(InputEventKey,"physical_keycode":65)])
}
right={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":4194321), Object(InputEventKey,"physical_keycode":68)])
}
up={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":4194320), Object(InputEventKey,"physical_keycode":87)])
}
down={
"deadzone": 0.2,
"events": Array[InputEvent]([Object(InputEventKey,"physical_keycode":4194322), Object(InputEventKey,"physical_keycode":83)])
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.07, 1)
